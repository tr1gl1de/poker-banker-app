<?xml version="1.0" encoding="utf-8"?>
<!-- Офлайн: в облачную резервную копию Google ничего не уходит. Перенос на новый телефон
     (device-to-device, по явному действию пользователя) разрешён — так игры не теряются. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
